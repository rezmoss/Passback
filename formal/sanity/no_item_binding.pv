(* Passback suite 1: two-secret key derivation and key hierarchy.

   The attacker holds everything a server or a stolen disk would: the header, the
   wrapped account key, wrapped vault and item keys and all sealed records. The
   Secret Key exists only on the user's devices.

   Properties:
   1. The master password resists offline guessing against stolen data
      (weaksecret), because the unlock key also needs the 128-bit Secret Key.
   2. Item plaintexts stay secret.
   SANITY: item ids removed from the associated data; the correspondence must fail.
   3. Context binding: a device reading item A never accepts content sealed for
      item B, even though both item keys are wrapped by the same vault key and the
      attacker controls storage. *)

free net: channel.
type key.

fun argon2id(bitstring, bitstring): key.          (* KDF(password, salt) *)
fun skkey(bitstring, bitstring): key.             (* HKDF(SecretKey, account) *)
fun unlockkey(key, key, bitstring): key.          (* HKDF(k_pw || k_sk, account, factors) *)
fun k2b(key): bitstring [data].

(* Committing AEAD with purpose and associated data. *)
fun seal(key, bitstring, bitstring, bitstring): bitstring.
reduc forall k: key, p: bitstring, ad: bitstring, m: bitstring;
  open(k, p, ad, seal(k, p, ad, m)) = m.

const ACCOUNT_KEY, VAULT_KEY, ITEM_KEY, ITEM_CONTENT: bitstring.
free salt, account, vault, itemA, itemB: bitstring.

free password: bitstring [private].
free secretKey: bitstring [private].
free contentA, contentB: bitstring [private].


event Sealed(bitstring, bitstring).
event Accepted(bitstring, bitstring).
query i: bitstring, m: bitstring; event(Accepted(i, m)) ==> event(Sealed(i, m)).

let author(vk: key) =
  new ikA: key; new ikB: key;
  event Sealed(itemA, contentA);
  event Sealed(itemB, contentB);
  out(net, seal(vk, ITEM_KEY, vault, k2b(ikA)));
  out(net, seal(ikA, ITEM_CONTENT, vault, contentA));
  out(net, seal(vk, ITEM_KEY, vault, k2b(ikB)));
  out(net, seal(ikB, ITEM_CONTENT, vault, contentB)).

(* A device reads a wrapped item key and content for item `i` from storage. *)
let reader(vk: key) =
  in(net, (i: bitstring, wk: bitstring, c: bitstring));
  let k2b(ik) = open(vk, ITEM_KEY, vault, wk) in
  let m = open(ik, ITEM_CONTENT, vault, c) in
  event Accepted(i, m).

process
  new ak: key; new vk: key;
  let uk = unlockkey(argon2id(password, salt), skkey(secretKey, account), account) in
  out(net, seal(uk, ACCOUNT_KEY, account, k2b(ak)));
  out(net, seal(ak, VAULT_KEY, vault, k2b(vk)));
  ( author(vk) | !reader(vk) )
